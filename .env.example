# 应用不会自动加载此文件。通过终端环境变量或部署工具注入，勿提交真实凭证。
TRACKER_DB=data/tracker.sqlite3
# 旧式管理员共享入口；仅在 TRACKER_INTERNAL_SHARED=false 时生效，配置后网页无需登录。
TRACKER_SHARED_USER_ID=
# 公司内部共享模式：网页和企微共用内部工作台身份，网页无需登录。
TRACKER_INTERNAL_SHARED=true
TRACKER_AI_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# 开启 AI 表示允许将当前消息和授权范围内的候选信息发送到 DeepSeek 官方 API。
# 触发催办的节点原因，逗号分隔，可选 overdue / stale / due_soon。
# 留空表示三者都催办（默认）；只填 due_soon 则仅在临近到期时提醒，
# 逾期与待更新仍照常在大屏和项目卡片上展示，只是不再生成催办任务。
TRACKER_REMINDER_REASONS=
# 企微接收进程默认关闭；已实现群内 @入口，真实账号尚待联调。
TRACKER_WECOM_SEND_ENABLED=false
WECOM_CORP_ID=
WECOM_APP_SECRET=
WECOM_AGENT_ID=
# 配置后主动提醒改为发送到该企业微信群；不要提交真实 Webhook。
WECOM_GROUP_WEBHOOK_URL=

# 智能机器人长连接（与上面的自建应用主动提醒分别配置）
TRACKER_WECOM_BOT_ENABLED=false
WECOM_BOT_ID=
WECOM_BOT_SECRET=
# 员工可访问的工作台根地址；不附带访问密钥，程序不会自动加载 .env
TRACKER_WEB_URL=
